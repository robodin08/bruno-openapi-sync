{
  "name": "bruno-openapi-sync",
  "version": "2.0.0",
  "license": "MIT",
  "author": "robodin08",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/sync.js",
  "types": "dist/sync.d.ts",
  "bin": {
    "bruno-openapi-sync": "dist/index.js"
  },
  "homepage": "https://github.com/robodin08/bruno-openapi-sync#readme",
  "bugs": {
    "url": "https://github.com/robodin08/bruno-openapi-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robodin08/bruno-openapi-sync.git"
  },
  "keywords": [
    "bruno",
    "openapi",
    "sync",
    "cli"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run build && npm run test:typecheck && npm test",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@usebruno/cli": "^4",
    "commander": "^15"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^5"
  }
}

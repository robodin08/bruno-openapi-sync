{
  "name": "bruno-openapi-sync",
  "version": "2.1.1",
  "license": "MIT",
  "author": "robodin08",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/sync.js",
  "types": "dist/sync.d.ts",
  "bin": {
    "bruno-openapi-sync": "./dist/index.js"
  },
  "homepage": "https://github.com/robodin08/bruno-openapi-sync#readme",
  "bugs": {
    "url": "https://github.com/robodin08/bruno-openapi-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robodin08/bruno-openapi-sync.git"
  },
  "keywords": [
    "bruno",
    "openapi",
    "sync",
    "cli"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "rimraf dist && tsc -b tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run build && npm run test:typecheck && npm test",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@usebruno/cli": "^4.2.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}

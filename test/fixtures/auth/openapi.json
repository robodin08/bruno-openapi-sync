{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth API",
    "version": "1.0.0"
  },
  "paths": {
    "/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token issued" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Logout",
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    }
  }
}
